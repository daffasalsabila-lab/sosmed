# MySQL (XAMPP / phpMyAdmin default: user root, tanpa password)
DATABASE_URL="mysql://root:@localhost:3306/connectspace"

PORT=5000
CLIENT_URL="http://localhost:5173"

# Ganti dengan string acak panjang (min 32 karakter)
JWT_SECRET="ganti-dengan-secret-acak-yang-panjang-minimal-32-karakter"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=10
