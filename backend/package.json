{
  "name": "connectspace-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API ConnectSpace (Express + Prisma + MySQL)",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
